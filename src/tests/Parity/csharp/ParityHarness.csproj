<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The original C# core is compiled from its sources (read-only); a ProjectReference would
       make dotnet write bin/ and obj/ into the C# solution's folder. By default the C# solution
       sits next to this repository (../SarwaveApplication); override with
       -p:SarwaveCSharpRoot=/path/to/SarwaveApplication. -->
  <PropertyGroup>
    <SarwaveCSharpRoot Condition="'$(SarwaveCSharpRoot)' == ''">$(MSBuildThisFileDirectory)../../../../../SarwaveApplication</SarwaveCSharpRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SarwaveCSharpRoot)/Sarwave.Core.MMWave/**/*.cs"
             Exclude="$(SarwaveCSharpRoot)/Sarwave.Core.MMWave/obj/**;$(SarwaveCSharpRoot)/Sarwave.Core.MMWave/bin/**" />
    <!-- CombinedManager and EntryPackage moved to Sarwave.Integration.PeopleTracking, which
         builds on the IMU library. -->
    <Compile Include="$(SarwaveCSharpRoot)/Sarwave.Core.Imu/**/*.cs"
             Exclude="$(SarwaveCSharpRoot)/Sarwave.Core.Imu/obj/**;$(SarwaveCSharpRoot)/Sarwave.Core.Imu/bin/**" />
    <Compile Include="$(SarwaveCSharpRoot)/Sarwave.Integration.PeopleTracking/**/*.cs"
             Exclude="$(SarwaveCSharpRoot)/Sarwave.Integration.PeopleTracking/obj/**;$(SarwaveCSharpRoot)/Sarwave.Integration.PeopleTracking/bin/**" />
    <PackageReference Include="System.IO.Ports" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>
</Project>
