<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The original C# IMU library compiled from its sources (read-only), as in ../csharp. -->
  <PropertyGroup>
    <SarwaveCSharpRoot Condition="'$(SarwaveCSharpRoot)' == ''">$(MSBuildThisFileDirectory)../../../../../SarwaveApplication</SarwaveCSharpRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SarwaveCSharpRoot)/Sarwave.Core.Imu/**/*.cs"
             Exclude="$(SarwaveCSharpRoot)/Sarwave.Core.Imu/obj/**;$(SarwaveCSharpRoot)/Sarwave.Core.Imu/bin/**" />
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>
</Project>
